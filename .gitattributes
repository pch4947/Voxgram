# Normalize line endings in the repository; check out native endings.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.wav   binary
*.flac  binary
*.mp3   binary
*.pdf   binary
*.npy   binary
*.npz   binary
